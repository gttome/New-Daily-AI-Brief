      "development_suites": [
        "validation-routing",
        "process-hardening"
      ],
      "integration_suites": [
        "validation-routing-integration"
      ],
      "dependencies": [],
      "rationale": "Validation control-plane changes require router/process contract checks and one CLI-level routing integration proof."
    },
    "changed-tests": {
      "paths": [
        "tests/**"
      ],
      "development_suites": [
        "changed-tests"
      ],
      "integration_suites": [],
      "dependencies": [],
      "rationale": "A changed Python test file executes itself; unrelated historical tests remain excluded."
    },
