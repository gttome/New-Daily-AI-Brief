{
  "schema_version": "1.0",
  "policy": "docs/TESTING_AND_VALIDATION_STANDARD.md",
  "fail_closed": true,
  "full_system_validation": {
    "workflow": ".github/workflows/full-system-validation.yml",
    "automatic": false,
    "suite_inventory": [
      "python-comprehensive",
      "reader-comprehensive",
      "command-center-comprehensive"
    ],
    "note": "Recommendation flags never auto-dispatch Full System Validation."
  },
  "components": {
    "metadata-only": {
      "paths": [
        "docs/**",
        "evidence/**",
        "README.md"
      ],
      "development_suites": [
        "closure-metadata"
      ],
      "integration_suites": [],
      "dependencies": [],
      "only_when_exclusive": true,
      "rationale": "Documentation/evidence metadata only; preserve a lightweight closure guard without system regression."
    },
    "testing-infrastructure": {
      "paths": [
        "config/test-impact-map.json",
        "scripts/select_validation.py",
        "scripts/run_validation.py",
        "tests/test_validation_routing.py",
        "tests/test_process_hardening.py",
        ".github/workflows/ci.yml",
        ".github/workflows/full-system-validation.yml",
