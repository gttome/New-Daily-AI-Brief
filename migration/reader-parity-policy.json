    },
    "shares_and_events": {
      "endpoint": "https://daily-ai-brief-ratings.gtome.chatgpt.site/api/events",
      "migration_strategy": "retained_in_place",
      "historical_values": "authoritative_service_state"
    },
    "comments": {
      "endpoint": "https://daily-ai-brief-ratings.gtome.chatgpt.site/api/comments",
      "migration_strategy": "retained_in_place",
      "privacy": "private_to_editor_90_day_retention",
