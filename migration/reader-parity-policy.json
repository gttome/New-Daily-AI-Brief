    "reader": "https://gttome.github.io/Daily-AI-Brief/",
    "pinned_sha": "4ac06268048a3241d2ecaa5ce7c2638266500d75",
    "snapshot_path": "legacy_snapshot",
    "snapshot_strategy": "git_submodule"
  },
  "reader_rules": {
    "parity_migration_not_redesign": true,
    "command_center_out_of_scope": true,
