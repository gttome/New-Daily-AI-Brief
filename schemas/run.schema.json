{
  "$id": "https://daily-ai-brief.local/schemas/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "anti_rework": {
      "properties": {
        "artifact_rebuilds": {
          "minimum": 0,
          "type": "integer"
        },
        "artifact_reuses": {
          "minimum": 0,
          "type": "integer"
        },
        "full_pipeline_restarts": {
          "minimum": 0,
          "type": "integer"
        },
        "locked_stage_reexecutions": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "locked_stage_reexecutions",
        "full_pipeline_restarts",
        "artifact_reuses",
        "artifact_rebuilds"
      ],
      "type": "object"
    },
    "completion_status": {
      "enum": [
        "in_progress",
        "editorial_locked",
        "build_locked",
        "validation_locked",
        "render_locked",
        "shadow_live_verified",
        "post_publication_evaluation_locked",
        "complete",
        "degraded",
        "failed"
      ]
    },
    "current_state": {
      "enum": [
        "Ready",
        "Acquiring",
        "Deciding",
        "Building",
        "Validating",
        "Releasing",
        "Deployed",
        "LiveVerified",
        "PostPublicationEvaluation",
        "OperationsReconciled",
        "Complete",
        "Recovering"
      ]
    },
    "edition_date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "incident_count": {
      "minimum": 0,
      "type": "integer"
    },
    "manual_intervention": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "synthetic",
        "shadow",
        "production"
      ]
    },
    "recovery_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage_executions": {
      "type": "object"
    },
    "stage_receipts": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "edition_date",
    "mode",
    "current_state",
    "completion_status",
    "stage_executions",
    "stage_receipts",
    "anti_rework"
  ],
  "title": "run",
  "type": "object"
}
