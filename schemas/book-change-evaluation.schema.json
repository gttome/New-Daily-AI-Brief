{
  "$id": "https://daily-ai-brief.local/schemas/book-change-evaluation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "evaluation_contract_version": {
          "const": "1.0.0"
        },
        "evaluator_adapter_version": {
          "const": "fixture-book-change-v1"
        },
        "edition_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bound_release": {
          "type": "object"
        },
        "evaluated_item_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluated_item_types": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "enum": [
              "article",
              "video",
              "podcast"
            ]
          }
        },
        "item_evaluations": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object"
          }
        },
        "all_items_evaluated": {
          "const": true
        },
        "proposal_records": {
          "type": "array"
        },
        "proposal_count": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "result_semantics": {
          "enum": [
            "true_zero",
            "proposals_present"
          ]
        },
        "missing_evaluation_is_zero": {
          "const": false
        },
        "shadow_only": {
          "const": true
        },
        "production_authorized": {
          "const": false
        }
      },
      "required": [
        "evaluation_contract_version",
        "evaluator_adapter_version",
        "edition_date",
        "bound_release",
        "evaluated_item_ids",
        "evaluated_item_types",
        "item_evaluations",
        "all_items_evaluated",
        "proposal_records",
        "proposal_count",
        "result",
        "result_semantics",
        "missing_evaluation_is_zero",
        "shadow_only",
        "production_authorized"
      ]
    },
    "edition_date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "input_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "mode": {
      "enum": [
        "synthetic",
        "shadow",
        "production"
      ]
    },
    "produced_by_stage": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "locked",
        "invalidated"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "content_digest",
    "produced_by_stage",
    "input_digests",
    "status",
    "data"
  ],
  "title": "book-change-evaluation",
  "type": "object"
}
