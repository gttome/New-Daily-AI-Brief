{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/production-integration-execution-preflight.schema.json",
  "title": "Iteration 14 Production Integration Execution Preflight Artifact Data",
  "type": "object",
  "required": [
    "execution_preflight_schema_version",
    "execution_preflight_policy_version",
    "execution_preflight_id",
    "admission_artifact_digest",
    "admission_id",
    "admission_classification",
    "plan_artifact_digest",
    "plan_id",
    "classification",
    "classification_reason_codes",
    "execution_envelope_bindings",
    "execution_steps",
    "real_integration_steps_enabled",
    "synthetic_only",
    "production_action_authorized",
    "production_cutover_authorized",
    "legacy_decommission_authorized",
    "production_publication",
    "final_state",
    "final_status"
  ],
  "properties": {
    "execution_preflight_schema_version": {"const": "1.0.0"},
    "execution_preflight_policy_version": {"const": "1.0.0"},
    "classification": {
      "enum": ["blocked", "execution_review_ready", "invalid"]
    },
    "admission_classification": {
      "enum": ["blocked", "authorization_ready", "invalid"]
    },
    "synthetic_only": {"const": true},
    "production_action_authorized": {"const": false},
    "production_cutover_authorized": {"const": false},
    "legacy_decommission_authorized": {"const": false},
    "production_publication": {"const": false},
    "final_state": {"const": "Complete"},
    "final_status": {"const": "complete_locked"},
    "execution_preflight_id": {"type": "string"},
    "admission_artifact_digest": {"type": "string"},
    "admission_id": {"type": "string"},
    "plan_artifact_digest": {"type": "string"},
    "plan_id": {"type": "string"},
    "classification_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "execution_envelope_bindings": {
      "type": "object",
      "required": [
        "executor_contract",
        "step_selection_scope",
        "step_enablement",
        "dry_run_assertions",
        "rollback_restore",
        "target_environment",
        "pre_execution_verification",
        "stop_abort_conditions",
        "cutover_decommission_state",
        "zero_incremental_cost"
      ],
      "additionalProperties": false
    },
    "execution_envelope_decision_id": {"type": ["string", "null"]},
    "execution_envelope_decision_digest": {"type": ["string", "null"]},
    "execution_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "enabled", "production_action_authorized"],
        "properties": {
          "step_id": {"type": "string"},
          "enabled": {"const": false},
          "production_action_authorized": {"const": false}
        },
        "additionalProperties": true
      }
    },
    "real_integration_steps_enabled": {"const": 0}
  },
  "additionalProperties": true
}
