{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-verification.schema.json",
  "title": "Offline Shadow Live Verification Receipt Data",
  "type": "object",
  "required": [
    "live_verification_contract_version",
    "verification_scope",
    "edition_date",
    "route_manifest_digest",
    "release_package_digest",
    "deployment_identity",
    "checked_route_ids",
    "checks",
    "result",
    "production_authorized",
    "shadow_only"
  ],
  "properties": {
    "live_verification_contract_version": {"const": "1.0.0"},
    "verification_scope": {"const": "shadow_offline"},
    "edition_date": {"type": "string"},
    "route_manifest_digest": {"type": "string", "pattern": "^sha256:"},
    "release_package_digest": {"type": "string", "pattern": "^sha256:"},
    "deployment_identity": {"type": "string", "pattern": "^shadow-deploy:"},
    "checked_route_ids": {"type": "array", "minItems": 11, "maxItems": 11},
    "checks": {"type": "object"},
    "result": {"const": "passed"},
    "production_authorized": {"const": false},
    "shadow_only": {"const": true}
  },
  "additionalProperties": false
}
