{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/production-integration-admission.schema.json",
  "title": "Iteration 13 Production Integration Admission Artifact Data",
  "type": "object",
  "required": [
    "admission_schema_version",
    "admission_policy_version",
    "admission_id",
    "plan_artifact_digest",
    "plan_id",
    "plan_classification",
    "classification",
    "classification_reason_codes",
    "evidence_bindings",
    "synthetic_only",
    "production_action_authorized",
    "production_cutover_authorized",
    "legacy_decommission_authorized",
    "production_publication",
    "final_state",
    "final_status"
  ],
  "properties": {
    "admission_schema_version": {"const": "1.0.0"},
    "admission_policy_version": {"const": "1.0.0"},
    "classification": {
      "enum": ["blocked", "authorization_ready", "invalid"]
    },
    "synthetic_only": {"const": true},
    "production_action_authorized": {"const": false},
    "production_cutover_authorized": {"const": false},
    "legacy_decommission_authorized": {"const": false},
    "production_publication": {"const": false},
    "final_state": {"const": "Complete"},
    "final_status": {"const": "complete_locked"},
    "admission_id": {"type": "string"},
    "plan_artifact_digest": {"type": "string"},
    "plan_id": {"type": "string"},
    "plan_classification": {
      "enum": ["blocked", "planned", "invalid"]
    },
    "classification_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence_bindings": {
      "type": "object",
      "required": [
        "discovery_adapter",
        "publication_target",
        "public_deployment_verification",
        "private_command_center",
        "production_schedules",
        "subscriber_delivery",
        "migration_prerequisites",
        "rollback_restore",
        "zero_incremental_cost"
      ],
      "additionalProperties": false
    },
    "admission_decision_id": {
      "type": ["string", "null"]
    },
    "admission_decision_digest": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
