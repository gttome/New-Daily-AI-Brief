{
  "$id": "https://daily-ai-brief.local/schemas/images.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "images",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_id", "artifact_type", "content_digest", "produced_by_stage", "input_digests", "status", "data"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "images"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "edition_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "mode": {"enum": ["synthetic", "shadow", "production"]},
    "produced_by_stage": {"type": "string", "minLength": 1},
    "input_digests": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "status": {"enum": ["locked", "invalidated"]},
    "data": {
      "type": "object",
      "required": ["image_contract_version", "edition_date", "accepted_count", "quality_contract", "images"],
      "properties": {
        "image_contract_version": {"const": "1.0.0"},
        "accepted_count": {"const": 6},
        "images": {"type": "array", "minItems": 6, "maxItems": 6}
      }
    }
  }
}
