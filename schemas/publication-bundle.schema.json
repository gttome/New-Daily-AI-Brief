{
  "$id": "https://daily-ai-brief.local/schemas/publication-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publication-bundle",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_id", "artifact_type", "content_digest", "produced_by_stage", "input_digests", "status", "data"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"const": "publication-bundle"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "edition_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "mode": {"enum": ["synthetic", "shadow", "production"]},
    "produced_by_stage": {"type": "string", "minLength": 1},
    "input_digests": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "status": {"enum": ["locked", "invalidated"]},
    "data": {
      "type": "object",
      "required": ["bundle_contract_version", "edition_date", "validation_result", "validation_checks", "ordered_input_digests", "release_authorized", "validation_only_boundary"],
      "properties": {
        "bundle_contract_version": {"const": "1.0.0"},
        "validation_result": {"const": "passed"},
        "release_authorized": {"const": false},
        "validation_only_boundary": {"const": true},
        "ordered_input_digests": {
          "type": "object",
          "required": ["edition", "media", "images", "watchlist", "book-bridges", "rating-contract"]
        }
      }
    }
  }
}
