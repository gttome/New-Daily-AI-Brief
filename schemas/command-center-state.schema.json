{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gttome.github.io/New-Daily-AI-Brief/schemas/command-center-state.schema.json",
  "title": "New Daily AI Brief Command Center State",
  "type": "object",
  "required": ["schema_version","source","privacy","executive","pipeline","stories","images","media","watchlist","book_bridges","reader_site","readiness_gates","manual_controls","schedules","run_history","source_health","usage_cost","incidents","engagement","command_center_site"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_generated_at": {"type": "string"},
    "source": {"type": "object","required":["repository","branch","main_sha"],"properties":{"repository":{"const":"gttome/New-Daily-AI-Brief"},"branch":{"const":"main"},"main_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "privacy": {"type":"object","required":["surface","contains_credentials","contains_private_ids","contains_internal_prompts","public_reader_exposure"],"properties":{"surface":{"const":"private-owner-only"},"contains_credentials":{"const":false},"contains_private_ids":{"const":false},"contains_internal_prompts":{"const":false},"public_reader_exposure":{"const":false}}},
    "executive": {"type":"object"},
    "pipeline": {"type":"array","minItems":11,"maxItems":11},
    "stories": {"type":"object","required":["count","allocation","agent_skills_count","allocation_pass","items"],"properties":{"count":{"const":6},"agent_skills_count":{"const":1},"allocation_pass":{"type":"boolean"},"items":{"type":"array","minItems":6,"maxItems":6}}},
    "images": {"type":"object","required":["accepted_count","items"],"properties":{"accepted_count":{"type":"integer","minimum":0,"maximum":6},"items":{"type":"array","minItems":6,"maxItems":6}}},
    "media": {"type":"object"},
    "watchlist": {"type":"object"},
    "book_bridges": {"type":"object"},
    "reader_site": {"type":"object"},
    "readiness_gates": {"type":"array","minItems":13},
    "manual_controls": {"type":"array","minItems":8},
    "schedules": {"type":"object","required":["creation_permitted","old_system_decommissioned","blocker","planned"],"properties":{"creation_permitted":{"const":false},"old_system_decommissioned":{"const":false},"planned":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["name","created","enabled","status"],"properties":{"created":{"const":false},"enabled":{"const":false}}}}}},
    "run_history": {"type":"array"},
    "source_health": {"type":"object"},
    "usage_cost": {"type":"object","required":["estimated"],"properties":{"estimated":{"const":false}}},
    "incidents": {"type":"object"},
    "engagement": {"type":"object"},
    "warnings": {"type":"array"},
    "command_center_site": {"type":"object","required":["identifier","publication_state","public_pages_deployment_allowed"],"properties":{"identifier":{"const":"npccs"},"public_pages_deployment_allowed":{"const":false}}}
  },
  "additionalProperties": true
}
